{
  "name": "cuentas-claras",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "npm --prefix dashboard run dev -- --host 0.0.0.0 --port 8081",
    "android": "expo start --android",
    "web": "npm run start",
    "web:expo": "expo start --web",
    "export:web": "npm --prefix dashboard run build",
    "export:expo-web": "expo export --platform web --output-dir dist",
    "legacy:payments:release:gate": "vitest run src/__tests__/backendReleaseGate.test.ts",
    "verify:android:prototype": "npm run typecheck && npm test && npx expo config --type public",
    "release:android:check": "npm run verify:android:prototype && node ./bin/tracker-release-gate.cjs",
    "build:android:internal": "eas build --platform android --profile internal",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:palari": "./bin/palari lint"
  },
  "dependencies": {
    "@expo/metro-runtime": "^56.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~56.0.16",
    "expo-font": "~56.0.7",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "^56.0.4",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~56.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
