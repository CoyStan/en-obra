{
  "name": "en-obra",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "start": "expo start",
    "dev:android": "expo start --android",
    "dev:expo-web": "expo start --web",
    "dev:dashboard": "npm run dev --workspace dashboard -- --host 0.0.0.0 --port 8081",
    "verify": "npm run typecheck && npm test && npx expo config --type public && npx expo-doctor",
    "build:android:apk": "npx eas-cli@16.28.0 build --platform android --profile pilot-apk",
    "build:android:aab": "npx eas-cli@16.28.0 build --platform android --profile play-aab",
    "pilot:android:check": "npm run verify && node ./bin/pilot-android-check.cjs",
    "production:android:check": "node ./bin/production-android-check.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint App.tsx src/tracker src/domain src/persistence src/screens src/components/tracker"
  },
  "dependencies": {
    "@expo/metro-runtime": "^56.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~56.0.16",
    "expo-font": "~56.0.7",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "^56.0.4",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~56.0.0",
    "oxlint": "^1.71.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
