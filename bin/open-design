#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
OPEN_DESIGN_HOME="${OPEN_DESIGN_HOME:-/home/quetza/projects/open-design}"

if [[ ! -d "$OPEN_DESIGN_HOME/.git" ]]; then
  echo "Open Design checkout not found at: $OPEN_DESIGN_HOME" >&2
  echo "Clone it with: git clone --depth 1 https://github.com/nexu-io/open-design.git $OPEN_DESIGN_HOME" >&2
  exit 1
fi

export PATH="$REPO_ROOT/tools/open-design/bin:$PATH"
cd "$OPEN_DESIGN_HOME"

if [[ $# -eq 0 ]]; then
  exec corepack pnpm exec od --help
fi

case "$1" in
  status|start|run|restart|logs|check|stop)
    exec corepack pnpm tools-dev "$@"
    ;;
  *)
    exec corepack pnpm exec od "$@"
    ;;
esac
